<resources>
    <!-- Makes the app the system's recents component: the "recents" protection level then grants it
         REMOVE_TASKS and MANAGE_ACTIVITY_TASKS (removing apps from the row, Kill all). TV builds leave this
         pointing at a launcher that isn't installed (mRecentsComponent=null in `dumpsys activity recents`), so
         nothing else holds it. A separate stub activity, so the overlay itself stays a normal activity. -->
    <string name="config_recentsComponentName" translatable="false">com.websnake.recentstv/com.websnake.recentstv.SystemRecentsActivity</string>
</resources>
